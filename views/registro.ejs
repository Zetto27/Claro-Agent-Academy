<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClaroAgent Academy — Registro</title>
    <link rel="stylesheet" href="resources/css/registro.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- AVISO -->
    <div class="aviso" id="aviso"></div>

    <!-- CONTENIDO -->
    <div class="content">
      <div class="card">
        <div class="card-header">
          <h2>Registro de agente</h2>
        </div>

        <form action="/registro"  method="POST" class="login-form" id="formRegistro" novalidate>
          <!-- Nombre -->
          <div class="campo">
            <label for="nombre">Nombre completo</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
              </span>
              <input type="text" name="nombre" id="nombre" placeholder="Tu nombre completo" required />
            </div>
            <span class="error-msg" id="err-nombre">Ingresa tu nombre completo.</span>
          </div>
                        <!-- Rol -->
                <div class="campo">
                <label for="rol">Rol</label>
                <div class="input-wrapper">
                    <span class="input-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5z"/>
                        <path d="M2 22c0-4 4-7 10-7s10 3 10 7"/>
                    </svg>
                    </span>

                    <select name="rol" id="rol" required>
                    <option value="">Selecciona un rol</option>
                    <option value="administrador">Administrador</option>
                    <option value="usuario">Usuario</option>
                    </select>
                </div>

                <span class="error-msg" id="err-rol">Selecciona un rol.</span>
                </div>

          <!-- Cédula -->
          <div class="campo">
            <label for="cedula">Cédula</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="16" rx="2" />
                  <path d="M8 10h8M8 14h5" />
                </svg>
              </span>
              <input
                type="text"
                name="cedula"
                id="cedula"
                placeholder="Número de cédula"
                required
                inputmode="numeric"
                maxlength="11" />
            </div>
            <span class="error-msg" id="err-cedula">Ingresa un número de cédula válido.</span>
            <!-- Correo -->
            <div class="campo">
            <label for="correo">Correo</label>
            <div class="input-wrapper">
                <span class="input-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16v16H4z" />
                    <path d="M22 6l-10 7L2 6" />
                </svg>
                </span>
                <input
                type="email"
                name="correo"
                id="correo"
                placeholder="Correo electrónico"
                required />
            </div>
            <span class="error-msg" id="err-correo">Ingresa un correo válido.</span>
            </div>

          <!-- Teléfono -->
          <div class="campo">
            <label for="telefono">Teléfono</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.78a16 16 0 0 0 6 6l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.78 16z" />
                </svg>
              </span>
              <input
                type="tel"
                name="telefono"
                id="telefono"
                placeholder="Número de teléfono"
                required
                inputmode="numeric"
                maxlength="10" />
            </div>
            <span class="error-msg" id="err-telefono">Ingresa un teléfono válido (mín. 7 dígitos).</span>
          </div>

          <!-- Contraseña -->
          <div class="campo">
            <label for="contrasena">Contraseña</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
              </span>
              <input type="password" name="contrasena" id="contrasena" placeholder="Crea tu contraseña" required minlength="6" />
            </div>
            <span class="error-msg" id="err-contrasena">La contraseña debe tener mínimo 6 caracteres.</span>
          </div>

          <!-- Botones -->
          <div class="btn-group">
            <button type="submit" class="btn-guardar">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                <polyline points="17 21 17 13 7 13 7 21" />
                <polyline points="7 3 7 8 15 8" />
              </svg>
              Guardar
            </button>
            <button type="button" class="btn-cancelar" id="btnCancelar">Cancelar</button>
          </div>
        </form>

        <div class="card-footer">Proyecto SENA 2025 — Karen Páez</div>
      </div>
    </div>

    <script>
      const form = document.getElementById("formRegistro");
      const aviso = document.getElementById("aviso");

      function mostrarError(id, mostrar) {
        const el = document.getElementById("err-" + id);
        const input = document.getElementById(id);
        if (el) el.style.display = mostrar ? "block" : "none";
        if (input) input.classList.toggle("invalido", mostrar);
      }

      function mostrarAviso(msg, tipo) {
        aviso.textContent = msg;
        aviso.className = "aviso " + tipo;
        setTimeout(() => {
          aviso.className = "aviso";
          aviso.textContent = "";
        }, 3500);
      }

      ["cedula", "telefono"].forEach((id) => {
        document.getElementById(id).addEventListener("input", function () {
          this.value = this.value.replace(/\D/g, "");
        });
      });

      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        const nombre = document.getElementById("nombre").value.trim();
        const cedula = document.getElementById("cedula").value.trim();
        const correo = document.getElementById("correo").value.trim();
        const telefono = document.getElementById("telefono").value.trim();
        const contrasena = document.getElementById("contrasena").value;
        const rol = document.getElementById("rol").value;

        let valido = true;

        if (!nombre) {
          mostrarError("nombre", true);
          valido = false;
        } else mostrarError("nombre", false);

        if (!cedula || cedula.length < 6) {
          mostrarError("cedula", true);
          valido = false;
        } else mostrarError("cedula", false);

        if (!correo || !correo.includes("@")) {
          mostrarError("correo", true);
          valido = false;
        } else mostrarError("correo", false);

        if (!telefono || telefono.length < 7) {
          mostrarError("telefono", true);
          valido = false;
        } else mostrarError("telefono", false);

        if (!contrasena || contrasena.length < 6) {
          mostrarError("contrasena", true);
          valido = false;
        } else mostrarError("contrasena", false);
        if (!rol) {
  mostrarError("rol", true);
  valido = false;
} else mostrarError("rol", false);

        if (!valido) {
          mostrarAviso("Por favor completa todos los campos correctamente.", "error");
          return;
        }

        try {
          const res = await fetch("http://localhost:3000/registro", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              nombre,
              cedula,
              correo,
              telefono,
              contrasena,
            }),
          });

          const data = await res.json();

          if (data.ok) {
            mostrarAviso("Usuario creado: " + data.usuario, "exito");
            form.reset();
          } else {
            mostrarAviso("Error: " + data.error, "error");
          }
        } catch (error) {
          mostrarAviso("Error de conexión con el servidor", "error");
        }
      });

      document.getElementById("btnCancelar").addEventListener("click", function () {
        form.reset();
        ["nombre", "cedula", "telefono", "contrasena"].forEach((id) => mostrarError(id, false));
        mostrarAviso("Formulario cancelado", "error");
      });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <% if(typeof alert != "undefined") {  %>
        <script>
            Swal.fire({
                title: '<%= alertTitle %>',
                text: "<%= alertMessage %>",
                icon: "<%= alertIcon %>",
                showConfirmButton: <%= showConfirmButton %>,
                timer: <%= timer %>,
            }).then(()=>{
                cargarVista = '/usuarios <%= ruta %>'
            })
        </script>
        <% }  %>
  </body>
</html>
