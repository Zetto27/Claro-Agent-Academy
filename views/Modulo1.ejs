<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Módulo 1 — Bienvenida | ClaroAgent Academy</title>
    <link rel="stylesheet" href="../resources/css/modulo1.css" />
  </head>
  <body>
    <% const contenido1 = contenido[0]; %>
<% const contenido2 = contenido[1]; %>
    <main class="contenido">
      <div class="intro">
        <span class="etiqueta">Módulo 1 de 5</span>
        <h2><%= modulo.titulo %></h2>
        <p><%= modulo.descripcion %></p>
      </div>

      <!-- Sección 1 -->
      <div class="acordeon" data-sec="1">
        <button class="acordeon-btn">
          <h4>🏢 <%= contenido1.titulo %></h4>
          <svg
            class="flecha"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
        <div class="acordeon-cuerpo">
          <div class="acordeon-inner">
            <%- contenido1.descripcion %>
          </div>
          </div>  
      </div>



      <!-- Sección 2 -->
      <div class="acordeon" data-sec="2">
        <button class="acordeon-btn">
          <h4>⚖️<%= contenido2.titulo %></h4>
          <svg
            class="flecha"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
        <div class="acordeon-cuerpo">
          <div class="acordeon-inner">
            <p>Hay leyes colombianas que regulan tu trabajo. Las más importantes son:</p>
            <div class="nota">
              <strong>Ley 2300/2023 — Horarios de contacto:</strong>
              <br />
              Lunes a Viernes: 7am — 7pm
              <br />
              Sábados: 8am — 3pm
              <br />
              Domingos y festivos: PROHIBIDO
            </div>
            <p>
              <strong>Ley 1581/2012:</strong>
              protege los datos personales del cliente. Nunca compartas datos de un cliente con terceros ni los uses
              para nada diferente al servicio.
            </p>
            <p>
              <strong>Regla de oro:</strong>
              si tienes duda sobre si puedes o no hacer algo, pregunta a tu supervisor antes de actuar.
            </p>
          </div>
        </div>
      </div>

      <!-- Quiz -->
      <div class="eval-card">
        <h3>📝 Quiz — Módulo 1</h3>
        <p class="desc">Responde las 2 preguntas y presiona "Evaluar".</p>
        <div id="quizCard" data-evaluacion="<%= evaluacion ? evaluacion.id_evaluacion : '' %>">

<% preguntas.forEach((p, i) => { %>

  <div class="pregunta" data-id="<%= p.id_pregunta %>">

    <p><%= (i + 1) + ". " + p.enunciado %></p>

    <div class="opciones">

      <% opciones
        .filter(o => o.id_pregunta === p.id_pregunta)
        .forEach(o => { %>

        <div class="opcion"
             data-id="<%= o.id_opcion %>"
             data-correcta="<%= o.es_correcta %>"
             onclick="elegirQuiz(this)">

          <span class="bolita"></span>
          <%= o.texto %>

        </div>

      <% }) %>

    </div>

  </div>

<% }) %>
</div>

        <button class="btn-evaluar" id="btnQuiz" onclick="evaluarQuiz()">Evaluar</button>
<div class="resultado" id="resQuiz">
  <div class="puntaje" id="puntajeQuiz">0/100%</div>
  <div class="etiqueta-res" id="etiquetaQuiz"></div>
</div>
          <button class="btn-reintentar" id="btnReintentar" onclick="reiniciarQuiz()" style="display: none">
            Reintentar
          </button>
        </div>
      </div>


    <nav class="nav-inferior">
      <a class="nav-item" href="/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <polyline points="9 22 9 12 15 12 15 22" />
        </svg>
        Inicio
      </a>
      <a class="nav-item activo" href="modulo1.html">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
        </svg>
        Módulo 1
      </a>
      <a class="nav-item" href="modulo2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6" />
        </svg>
        Siguiente
      </a>
    </nav>

    <script>
      document.querySelectorAll(".acordeon-btn").forEach(btn => {
  btn.addEventListener("click", () => {

    const acordeon = btn.parentElement;

    // cerrar otros (opcional tipo profesional)
    document.querySelectorAll(".acordeon").forEach(a => {
      if (a !== acordeon) {
        a.classList.remove("activo");
      }
    });

    // toggle actual
    acordeon.classList.toggle("activo");
  });
});

      function elegirQuiz(el) {
  el.closest(".pregunta")
    .querySelectorAll(".opcion")
    .forEach(o => o.classList.remove("elegida"));

  el.classList.add("elegida");
}

console.log("FUNCION NUEVA CARGADA");
async function evaluarQuiz() {

  // 🔥 SOLO UNA VEZ (correcto)
  const card = document.getElementById("quizCard");
  const id_evaluacion = card ? card.dataset.evaluacion : null;

  console.log("ID_EVALUACION FRONT:", id_evaluacion);

  const preguntas = document.querySelectorAll(".pregunta");

  let respuestas = [];

  preguntas.forEach(p => {
    const seleccionada = p.querySelector(".opcion.elegida");

    if (!seleccionada) return;

    respuestas.push({
      id_pregunta: p.dataset.id,
      id_opcion: seleccionada.dataset.id
    });
  });

  console.log("RESPUESTAS FRONT:", respuestas);

  const res = await fetch("/guardar-intento", {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      respuestas: respuestas,
      id_evaluacion: id_evaluacion
    })
  });

  const data = await res.json();

  console.log("RESPUESTA BACKEND:", data);

if (!data.ok) {
  alert(data.mensaje);
  return;
}

// 🟢 mostrar resultado en pantalla
document.getElementById("resQuiz").style.display = "block";

// 🟢 mostrar puntaje
document.getElementById("puntajeQuiz").innerText =
  data.puntaje + "%";

// 🟢 mensaje de intento
let mensaje =
  "Intento " + data.intento_actual + " de " + data.limite;

// 🟢 aprobado o no
if (data.aprobado) {
  mensaje += " • ✅ Aprobaste";
} else {
  mensaje += " • ❌ No aprobaste";
}

// 🟢 mostrar mensaje
document.getElementById("etiquetaQuiz").innerText = mensaje;
}


    </script>
  </body>
</html>
