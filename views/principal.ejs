<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Claro Agent Academy</title>

    <!-- CSS -->
    <link rel="stylesheet" href="resources/css/principal.css" />
  </head>

  <body>
    <main class="contenido">
      <!-- Bienvenida -->
      <div class="bienvenida">
        <h2>
          ¡Hola,
          <strong><%= nombre %></strong>
          !
        </h2>
        <p class="info"><%= rol %></p>
      </div>

      <!-- Progreso 
      <div class="progreso-card">
        <div class="numero">0/5</div>
        <div class="texto">módulos completados</div>
      </div>
      -->

      <!-- Módulos -->
      <p class="seccion-titulo">Cursos asignados</p>

      <div class="modulo-card activo">
        <div class="modulo-emoji">🏢</div>
        <div class="modulo-info">
          <h3>PBX Móvil</h3>
        </div>
        <span class="modulo-estado estado-activo">
          <a class="modulo-estado estado-activo" href="/modulo1">▶ INICIAR</a>
        </span>
      </div>

      <div class="modulo-card bloqueado">Tornado</div>
      <div class="modulo-card bloqueado">Mensajería Masiva</div>
      <div class="modulo-card bloqueado">Aranda</div>
      <div class="modulo-card bloqueado">Claro Directo</div>

      <!-- Insignias 
      <p class="seccion-titulo">Insignias</p>

      <div class="insignias-card">
        <div class="insignias-grid">
          <div class="insignia">🔒 M1</div>
          <div class="insignia">🔒 M2</div>
          <div class="insignia">🔒 M3</div>
        </div>
      </div>
      -->
    </main>
  </body>
</html>
