<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Claro Agent Academy</title>

    <!-- CSS -->
    <link rel="stylesheet" href="resources/css/principal.css" />
  </head>

  <body>
    <main class="contenido">
      <!-- Bienvenida -->
      <div class="bienvenida">
        <h2>
          ¡Hola,
          <strong><%= nombre %></strong>
          !
        </h2>
        <p class="info"><%= rol %></p>
      </div>

      <div class="progreso-box">
        <h3>Tu progreso</h3>

        <div class="barra">
          <div class="barra-fill" style="width: <%= porcentaje %>%"></div>
        </div>

        <p><%= porcentaje %>% completado</p>
        <p><%= completados %> de <%= total %> módulos</p>
      </div>

      <!-- Progreso 
      <div class="progreso-card">
        <div class="numero">0/5</div>
        <div class="texto">módulos completados</div>
      </div>
      -->

      <!-- Módulos -->



      <div class="modulos">

  <% modulos.forEach(m => { %>

    <div class="modulo-card <%= m.desbloqueado ? '' : 'bloqueado' %>">

      <h4><%= m.titulo %></h4>

      <% if (m.aprobado) { %>
        <span class="estado aprobado">✅ Completado</span>
      <% } else if (m.desbloqueado) { %>
        <span class="estado pendiente">🟡 Disponible</span>
      <% } else { %>
        <span class="estado bloqueado">🔒 Bloqueado</span>
      <% } %>

      <% if (m.desbloqueado) { %>
        <a class="modulo-estado estado-activo" href="/modulo/<%= m.id_modulo %>">Entrar</a>
      <% } %>

    </div>

  <% }) %>

</div>

      
    </main>
  </body>
</html>
