<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Módulo 2 — PBX Móvil | ClaroAgent Academy</title>
    <style>
      :root {
        --rojo: #da291c;
        --rojo-oscuro: #a81e13;
        --rojo-claro: #fdecea;
        --blanco: #ffffff;
        --gris-fondo: #f5f5f5;
        --gris-borde: #e0e0e0;
        --gris-texto: #757575;
        --negro: #212121;
        --verde: #2e7d32;
        --naranja: #e65100;
        --acento: #ff6f00;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: "Segoe UI", Arial, sans-serif;
        background: var(--gris-fondo);
        color: var(--negro);
        line-height: 1.6;
        padding-bottom: 70px;
      }
      .mod-header {
        background: var(--rojo);
        color: var(--blanco);
        padding: 14px 16px;
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .mod-header-top {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .btn-volver {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: var(--blanco);
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }
      .mod-header-top h1 {
        font-size: 0.9rem;
        flex: 1;
      }
      .mod-header-top .emoji {
        font-size: 1.2rem;
      }
      .mod-barra {
        background: rgba(255, 255, 255, 0.2);
        height: 4px;
        margin-top: 8px;
        border-radius: 2px;
      }
      .mod-barra-fill {
        height: 100%;
        background: var(--blanco);
        border-radius: 2px;
        transition: width 0.4s;
        width: 0%;
      }
      .contenido {
        max-width: 600px;
        margin: 0 auto;
        padding: 16px;
      }
      .intro {
        background: var(--blanco);
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 14px;
        border-left: 4px solid var(--rojo);
      }
      .intro .etiqueta {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--rojo);
        text-transform: uppercase;
      }
      .intro h2 {
        font-size: 1.1rem;
        margin: 4px 0 6px;
      }
      .intro p {
        font-size: 0.85rem;
        color: var(--gris-texto);
      }
      .acordeon {
        background: var(--blanco);
        border-radius: 10px;
        margin-bottom: 10px;
        overflow: hidden;
      }
      .acordeon-btn {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 14px 16px;
        background: var(--blanco);
        border: none;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--negro);
        text-align: left;
      }
      .acordeon-btn:hover {
        background: var(--gris-fondo);
      }
      .acordeon-btn .flecha {
        margin-left: auto;
        transition: transform 0.3s;
      }
      .acordeon-btn.abierto .flecha {
        transform: rotate(180deg);
      }
      .acordeon-cuerpo {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s;
      }
      .acordeon-inner {
        padding: 0 16px 16px;
        font-size: 0.88rem;
        line-height: 1.7;
      }
      .acordeon-inner p {
        margin-bottom: 12px;
      }
      .acordeon-inner ul {
        padding-left: 20px;
        margin-bottom: 12px;
      }
      .acordeon-inner li {
        margin-bottom: 4px;
      }
      .nota {
        background: var(--rojo-claro);
        border-left: 3px solid var(--rojo);
        padding: 10px 14px;
        border-radius: 0 6px 6px 0;
        margin: 10px 0;
        font-size: 0.82rem;
      }
      .tabla-simple {
        width: 100%;
        border-collapse: collapse;
        margin: 10px 0;
        font-size: 0.8rem;
      }
      .tabla-simple th {
        background: var(--rojo);
        color: var(--blanco);
        padding: 8px 10px;
        text-align: left;
      }
      .tabla-simple td {
        padding: 8px 10px;
        border-bottom: 1px solid var(--gris-borde);
      }
      .tabla-simple tr:nth-child(even) td {
        background: var(--gris-fondo);
      }
      .eval-card {
        background: var(--blanco);
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 14px;
      }
      .eval-card h3 {
        font-size: 0.95rem;
        margin-bottom: 6px;
      }
      .eval-card .desc {
        font-size: 0.8rem;
        color: var(--gris-texto);
        margin-bottom: 16px;
      }
      .pregunta {
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--gris-borde);
      }
      .pregunta:last-of-type {
        border-bottom: none;
        padding-bottom: 0;
        margin-bottom: 0;
      }
      .pregunta p {
        font-size: 0.88rem;
        font-weight: 600;
        margin-bottom: 8px;
      }
      .opciones {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .opcion {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        background: var(--gris-fondo);
        border: 2px solid var(--gris-borde);
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        min-height: 42px;
      }
      .opcion:hover {
        border-color: var(--rojo);
      }
      .opcion.elegida {
        border-color: var(--rojo);
        background: var(--rojo-claro);
        font-weight: 600;
      }
      .opcion.correcta {
        border-color: var(--verde);
        background: #e8f5e9;
      }
      .opcion.incorrecta {
        border-color: var(--naranja);
        background: #fff3e0;
      }
      .opcion.deshabilitada {
        pointer-events: none;
        opacity: 0.7;
      }
      .opcion .bolita {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 2px solid var(--gris-borde);
        flex-shrink: 0;
      }
      .opcion.elegida .bolita {
        border-color: var(--rojo);
        background: var(--rojo);
      }
      .retroalimentacion {
        display: none;
        margin-top: 6px;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 0.78rem;
      }
      .retroalimentacion.ok {
        display: block;
        background: #e8f5e9;
        color: var(--verde);
      }
      .retroalimentacion.mal {
        display: block;
        background: #fff3e0;
        color: var(--naranja);
      }
      .btn-evaluar {
        display: block;
        width: 100%;
        padding: 12px;
        margin-top: 14px;
        font-size: 0.9rem;
        font-weight: 700;
        font-family: inherit;
        color: var(--blanco);
        background: var(--rojo);
        border: none;
        border-radius: 6px;
        cursor: pointer;
        min-height: 42px;
      }
      .btn-evaluar:hover {
        background: var(--rojo-oscuro);
      }
      .resultado {
        display: none;
        text-align: center;
        padding: 16px;
        margin-top: 12px;
        border-radius: 10px;
      }
      .resultado.aprobado {
        background: #e8f5e9;
      }
      .resultado.reprobado {
        background: #fff3e0;
      }
      .resultado .puntaje {
        font-size: 1.8rem;
        font-weight: 700;
      }
      .resultado .etiqueta-res {
        font-size: 0.82rem;
        color: var(--gris-texto);
        margin-top: 4px;
      }
      .btn-reintentar {
        display: inline-block;
        margin-top: 10px;
        padding: 8px 20px;
        font-size: 0.82rem;
        font-weight: 700;
        font-family: inherit;
        color: var(--blanco);
        background: var(--acento);
        border: none;
        border-radius: 6px;
        cursor: pointer;
      }
      .escenario {
        background: var(--gris-fondo);
        padding: 14px;
        border-radius: 6px;
        margin-bottom: 10px;
        border-left: 3px solid var(--acento);
        font-size: 0.88rem;
        font-style: italic;
      }
      .caso-fb {
        display: none;
        margin-top: 6px;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 0.78rem;
      }
      .caso-fb.visible {
        display: block;
      }
      .completado {
        display: none;
        background: var(--verde);
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 14px;
        color: var(--blanco);
        text-align: center;
      }
      .completado.visible {
        display: block;
      }
      .completado .emoji-grande {
        font-size: 2.5rem;
        margin-bottom: 8px;
      }
      .completado h3 {
        font-size: 1rem;
      }
      .completado p {
        font-size: 0.82rem;
        opacity: 0.9;
      }
      .btn-siguiente {
        display: inline-block;
        margin-top: 14px;
        padding: 10px 24px;
        background: var(--blanco);
        color: var(--verde);
        font-size: 0.88rem;
        font-weight: 700;
        font-family: inherit;
        border: none;
        border-radius: 20px;
        cursor: pointer;
      }
      .nav-inferior {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: var(--blanco);
        border-top: 1px solid var(--gris-borde);
        display: flex;
        justify-content: space-around;
        padding: 8px 0;
        z-index: 50;
      }
      .nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: var(--gris-texto);
        font-size: 0.6rem;
        gap: 2px;
        min-height: 40px;
        justify-content: center;
      }
      .nav-item.activo {
        color: var(--rojo);
      }
      .nav-item svg {
        width: 20px;
        height: 20px;
      }
    </style>
  </head>
  <body>
    <header class="mod-header">
      <div class="mod-header-top">
        <button class="btn-volver" onclick="location.href = 'dashboard.html'">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
        <h1>M2: PBX Móvil y Plataforma</h1>
        <span class="emoji">📡</span>
      </div>
      <div class="mod-barra"><div class="mod-barra-fill" id="barraModulo"></div></div>
    </header>

    <main class="contenido">
      <div class="intro">
        <span class="etiqueta">Módulo 2 de 5</span>
        <h2>PBX Móvil y su Plataforma Web</h2>
        <p>Entiende qué es el PBX Móvil de Claro y cómo se usa la consola de administración.</p>
      </div>

      <div class="acordeon" data-sec="1">
        <button class="acordeon-btn">
          📱 ¿Qué es el PBX Móvil?
          <svg
            class="flecha"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
        <div class="acordeon-cuerpo">
          <div class="acordeon-inner">
            <p>
              PBX significa
              <strong>Private Branch Exchange</strong>
              — es como una centralita telefónica, pero 100% virtual. No necesita hardware ni cables: funciona con los
              celulares de los empleados de la empresa.
            </p>
            <p>
              La empresa contrata un
              <strong>número único</strong>
              (ej: +57 323 563 9033) y cuando un cliente llama, el sistema redistribuye la llamada a los celulares de
              los empleados registrados.
            </p>
            <table class="tabla-simple">
              <tr>
                <th>Componente</th>
                <th>¿Qué hace?</th>
              </tr>
              <tr>
                <td><strong>Número cabecera</strong></td>
                <td>Número principal de la empresa</td>
              </tr>
              <tr>
                <td><strong>IVR (menú de voz)</strong></td>
                <td>"Pulse 1 para Ventas, 2 para Soporte..."</td>
              </tr>
              <tr>
                <td><strong>Agentes</strong></td>
                <td>Celulares registrados que reciben las llamadas</td>
              </tr>
              <tr>
                <td><strong>Horario</strong></td>
                <td>Define cuándo la empresa está "abierta"</td>
              </tr>
              <tr>
                <td><strong>Mensajes</strong></td>
                <td>Bienvenida, cierre, agentes ocupados</td>
              </tr>
            </table>
          </div>
        </div>
      </div>

      <div class="acordeon" data-sec="2">
        <button class="acordeon-btn">
          💻 La consola web
          <svg
            class="flecha"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
        <div class="acordeon-cuerpo">
          <div class="acordeon-inner">
            <p>
              El cliente administra su PBX desde
              <strong>pbxmovil.claro.com.co</strong>
              . Allí puede:
            </p>
            <ul>
              <li>
                <strong>Agregar agentes:</strong>
                con número en formato
                <strong>+57</strong>
                + 10 dígitos
              </li>
              <li>
                <strong>Configurar horario:</strong>
                definir franjas por día de la semana
              </li>
              <li>
                <strong>Grabar mensajes:</strong>
                bienvenida, cierre y "ocupados" (en .mp3 o .wav)
              </li>
              <li>
                <strong>Toggle Abierto/Cerrado:</strong>
                cierre manual inmediato
              </li>
            </ul>
            <div class="nota">
              <strong>Error más común:</strong>
              El cliente registra un agente SIN el prefijo +57 → las llamadas nunca le llegan. Siempre verifica esto
              primero.
            </div>
          </div>
        </div>
      </div>

      <!-- Quiz -->
      <div class="eval-card" id="quizCard">
        <h3>📝 Quiz — Módulo 2</h3>
        <p class="desc">2 preguntas. Mínimo 60 puntos.</p>
        <div class="pregunta" data-correct="2">
          <p>1. ¿El PBX Móvil necesita hardware?</p>
          <div class="opciones">
            <div class="opcion" data-v="0" onclick="elegirQuiz(this)">
              <span class="bolita"></span>
              Sí, un servidor
            </div>
            <div class="opcion" data-v="1" onclick="elegirQuiz(this)">
              <span class="bolita"></span>
              Sí, un router especial
            </div>
            <div class="opcion" data-v="2" onclick="elegirQuiz(this)">
              <span class="bolita"></span>
              No, es 100% en la nube
            </div>
          </div>
          <div class="retroalimentacion" id="fb1"></div>
        </div>
        <div class="pregunta" data-correct="0">
          <p>2. ¿En qué formato se registran los agentes?</p>
          <div class="opciones">
            <div class="opcion" data-v="0" onclick="elegirQuiz(this)">
              <span class="bolita"></span>
              +57 seguido de 10 dígitos
            </div>
            <div class="opcion" data-v="1" onclick="elegirQuiz(this)">
              <span class="bolita"></span>
              Solo los 10 dígitos
            </div>
            <div class="opcion" data-v="2" onclick="elegirQuiz(this)">
              <span class="bolita"></span>
              Con prefijo 03
            </div>
          </div>
          <div class="retroalimentacion" id="fb2"></div>
        </div>
        <button class="btn-evaluar" id="btnQuiz" onclick="evaluarQuiz()">Evaluar</button>
        <div class="resultado" id="resQuiz">
          <div class="puntaje" id="puntajeQuiz">0/100</div>
          <div class="etiqueta-res" id="etiquetaQuiz"></div>
          <button class="btn-reintentar" id="btnReintentar" onclick="reiniciarQuiz()" style="display: none">
            Reintentar
          </button>
        </div>
      </div>

      <!-- Caso -->
      <div class="eval-card" id="casoCard">
        <h3>🎯 Caso práctico</h3>
        <div class="escenario">
          Un cliente dice: "Agregué a mi empleado pero las llamadas no le llegan". ¿Qué verificas primero?
        </div>
        <div class="opciones" id="opcionesCaso">
          <div class="opcion" data-v="0" onclick="elegirCaso(this)">
            <span class="bolita"></span>
            Si tiene señal celular
          </div>
          <div class="opcion" data-v="1" onclick="elegirCaso(this)">
            <span class="bolita"></span>
            Si el número tiene el prefijo +57
          </div>
          <div class="opcion" data-v="2" onclick="elegirCaso(this)">
            <span class="bolita"></span>
            Si tiene plan de datos
          </div>
        </div>
        <div class="caso-fb" id="casoFb"></div>
        <button class="btn-evaluar" id="btnCaso" onclick="evaluarCaso()" style="margin-top: 10px">Verificar</button>
      </div>

      <div class="completado" id="completado">
        <div class="emoji-grande">📡</div>
        <h3>¡Módulo 2 completado!</h3>
        <p>
          Insignia:
          <strong>Agente Técnico</strong>
        </p>
        <button class="btn-siguiente" onclick="location.href = 'modulo3.html'">Siguiente módulo →</button>
      </div>
    </main>

    <nav class="nav-inferior">
      <a class="nav-item" href="dashboard.html">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <polyline points="9 22 9 12 15 12 15 22" />
        </svg>
        Inicio
      </a>
      <a class="nav-item" href="modulo1.html">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        Anterior
      </a>
      <a class="nav-item activo" href="modulo2.html">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
        </svg>
        Módulo 2
      </a>
      <a class="nav-item" href="modulo3.html">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6" />
        </svg>
        Siguiente
      </a>
    </nav>

    <script>
      (function () {
        var r = localStorage.getItem("claroAgentData");
        if (!r) {
          location.href = "modulo2";
          return;
        }
        var d = JSON.parse(r);
        if (!d.progreso.modulos[0]) location.href = "dashboard.html";
      })();
      var MOD = 1,
        MIN_PUNTAJE = 60,
        MAX_INT = 3,
        intentos = 0,
        quizOk = false,
        casoOk = false,
        totalSec = 2,
        secAbiertas = new Set();
      document.querySelectorAll(".acordeon-btn").forEach(function (b) {
        b.addEventListener("click", function () {
          var c = this.nextElementSibling;
          if (this.classList.contains("abierto")) {
            this.classList.remove("abierto");
            c.style.maxHeight = null;
          } else {
            this.classList.add("abierto");
            c.style.maxHeight = c.scrollHeight + "px";
            secAbiertas.add(this.closest(".acordeon").getAttribute("data-sec"));
            actualizarBarra();
          }
        });
      });
      function actualizarBarra() {
        document.getElementById("barraModulo").style.width =
          Math.round((secAbiertas.size / totalSec) * 50 + (quizOk ? 25 : 0) + (casoOk ? 25 : 0)) + "%";
      }
      function elegirQuiz(el) {
        el.closest(".pregunta")
          .querySelectorAll(".opcion")
          .forEach(function (o) {
            o.classList.remove("elegida");
          });
        el.classList.add("elegida");
      }
      var FBS = [
        { ok: "✓ Correcto — PBX Móvil es 100% en la nube.", mal: "✗ Incorrecto. Es <strong>100% en la nube</strong>." },
        {
          ok: "✓ Correcto — Formato: +57 + 10 dígitos.",
          mal: "✗ Incorrecto. Formato: <strong>+57 + 10 dígitos</strong>.",
        },
      ];
      function evaluarQuiz() {
        var ps = document.querySelectorAll(".pregunta"),
          ok = true;
        ps.forEach(function (p) {
          if (!p.querySelector(".opcion.elegida")) ok = false;
        });
        if (!ok) {
          alert("Responde las dos.");
          return;
        }
        intentos++;
        var b = 0;
        ps.forEach(function (p, i) {
          var cv = p.getAttribute("data-correct"),
            s = p.querySelector(".opcion.elegida"),
            sv = s.getAttribute("data-v"),
            fb = document.getElementById("fb" + (i + 1));
          p.querySelectorAll(".opcion").forEach(function (o) {
            o.classList.add("deshabilitada");
          });
          if (sv === cv) {
            b++;
            s.classList.add("correcta");
            fb.className = "retroalimentacion ok";
            fb.innerHTML = FBS[i].ok;
          } else {
            s.classList.add("incorrecta");
            p.querySelectorAll(".opcion").forEach(function (o) {
              if (o.getAttribute("data-v") === cv) o.classList.add("correcta");
            });
            fb.className = "retroalimentacion mal";
            fb.innerHTML = FBS[i].mal;
          }
        });
        var pts = b * 50;
        document.getElementById("puntajeQuiz").textContent = pts + "/100";
        document.getElementById("btnQuiz").style.display = "none";
        var r = document.getElementById("resQuiz");
        if (pts >= MIN_PUNTAJE) {
          quizOk = true;
          r.className = "resultado aprobado";
          r.style.display = "block";
          document.getElementById("puntajeQuiz").style.color = "var(--verde)";
          document.getElementById("etiquetaQuiz").textContent = "¡Aprobado!";
          actualizarBarra();
          verificar();
        } else {
          r.className = "resultado reprobado";
          r.style.display = "block";
          document.getElementById("puntajeQuiz").style.color = "var(--naranja)";
          if (intentos >= MAX_INT) {
            document.getElementById("etiquetaQuiz").textContent = "Sin intentos. Reinicia.";
            document.getElementById("btnReintentar").textContent = "Reiniciar";
            document.getElementById("btnReintentar").style.display = "inline-block";
            document.getElementById("btnReintentar").onclick = function () {
              location.reload();
            };
          } else {
            document.getElementById("etiquetaQuiz").textContent = "Mínimo 60 pts. Intento " + intentos + "/" + MAX_INT;
            document.getElementById("btnReintentar").style.display = "inline-block";
          }
        }
      }
      function reiniciarQuiz() {
        document.querySelectorAll(".opcion").forEach(function (o) {
          o.classList.remove("elegida", "correcta", "incorrecta", "deshabilitada");
        });
        document.querySelectorAll(".retroalimentacion").forEach(function (f) {
          f.className = "retroalimentacion";
          f.innerHTML = "";
        });
        document.getElementById("resQuiz").style.display = "none";
        document.getElementById("btnReintentar").style.display = "none";
        document.getElementById("btnQuiz").style.display = "block";
      }
      function elegirCaso(el) {
        document.querySelectorAll("#opcionesCaso .opcion").forEach(function (o) {
          o.classList.remove("elegida");
        });
        el.classList.add("elegida");
      }
      function evaluarCaso() {
        var s = document.querySelector("#opcionesCaso .opcion.elegida");
        if (!s) {
          alert("Selecciona.");
          return;
        }
        var v = s.getAttribute("data-v"),
          C = "1",
          fb = document.getElementById("casoFb");
        document.querySelectorAll("#opcionesCaso .opcion").forEach(function (o) {
          o.style.pointerEvents = "none";
          if (o.getAttribute("data-v") === C) o.classList.add("correcta");
        });
        document.getElementById("btnCaso").style.display = "none";
        if (v === C) {
          s.classList.add("correcta");
          fb.innerHTML = "<strong>✓ Correcto:</strong> Lo primero es verificar el prefijo +57.";
          fb.style.background = "#E8F5E9";
          fb.style.color = "var(--verde)";
        } else {
          s.classList.add("incorrecta");
          fb.innerHTML =
            "<strong>✗ Incorrecto.</strong> Primero verifica el <strong>prefijo +57</strong>. Respuesta: B.";
          fb.style.background = "#FFF3E0";
          fb.style.color = "var(--naranja)";
        }
        fb.classList.add("visible");
        casoOk = true;
        actualizarBarra();
        verificar();
      }
      function verificar() {
        if (quizOk && casoOk) {
          var d = JSON.parse(localStorage.getItem("claroAgentData")),
            p = parseInt(document.getElementById("puntajeQuiz").textContent);
          d.progreso.modulos[MOD] = true;
          d.progreso.puntajes[MOD] = p;
          if (p >= MIN_PUNTAJE) d.progreso.insignias[MOD] = true;
          localStorage.setItem("claroAgentData", JSON.stringify(d));
          setTimeout(function () {
            document.getElementById("completado").classList.add("visible");
            document.getElementById("completado").scrollIntoView({ behavior: "smooth" });
          }, 500);
        }
      }
    </script>
  </body>
</html>
