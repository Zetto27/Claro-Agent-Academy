<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClaroAgent Academy — Ingreso</title>
    <link rel="stylesheet" href="resources/css/login.css" />
  </head>
  <body>
    <div class="aviso" id="aviso"></div>

    <div class="login-box">
      <div class="login-header">
        <div class="logo-icon">CA</div>
        <h1>Claro Agent Academy</h1>
        <p>Evaluación para agentes — PBX Móvil</p>
      </div>

      <form method="post" action="/auth" class="login-form" id="formRegistro" novalidate>
        <div class="campo">
          <label for="nombre">Usuario</label>
          <div class="input-wrapper">
            <span class="input-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            </span>
            <input type="text" name="usuario" id="usuario" placeholder="Tu usuario" required />
          </div>
        </div>

        <div class="campo">
          <label for="contrasena">Contraseña</label>
          <div class="input-wrapper">
            <span class="input-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
            </span>
            <input
              type="password"
              name="contrasena"
              name="contrasena"
              id="contrasena"
              placeholder="Tu contraseña"
              required />
          </div>
        </div>

        <button type="submit" class="btn-entrar">Ingresar</button>
      </form>

      <div class="login-pie">Proyecto SENA 2025 — Karen Páez</div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <% if(typeof alert != "undefined") {  %>
        <script>
            Swal.fire({
                title: '<%= alertTitle %>',
                text: "<%= alertMessage %>",
                icon: "<%= alertIcon %>",
                showConfirmButton: <%= showConfirmButton %>,
                timer: <%= timer %>,
            }).then(()=>{
                window.location = '/<%= ruta %>'
            })
        </script>
        <% }  %>
  </body>
</html>
