<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Claro Agent Academy</title>
    <link rel="stylesheet" href="resources/css/index.css" />
  </head>

  <body>
    <header class="header">
      <div class="header-izq">
        <button class="btn-menu" id="btnMenu">☰</button>
        <h1>Claro Agent Academy</h1>
      </div>

      <a href="/login" class="btn-salir">Salir</a>
    </header>

    <div class="layout">
      <!-- SIDEBAR -->
      <aside class="sidebar">
        <div class="sidebar-header">
          <div class="sidebar-logo">CA</div>
          <div>
            <!-- nombre dinamico -->
            <div class="sidebar-titulo"><strong><%= nombre %></strong></div>
            <div class="sidebar-subtitulo">PBX Móvil</div>
          </div>
        </div>

        <p class="sidebar-seccion">Módulos</p>

        <nav class="sidebar-nav">
          <a href="#" class="side-item activo" onclick="cargarVista('principal')">🏠 Inicio</a>
          <div class="side-item desplegable" onclick="toggleSubmenu(this)">☎️ PBX Móvil</div>

          <div class="submenu">
            <a href="#" onclick="cargarVista('modulo1')">Bienvenida a Claro</a>
            <a href="#" onclick="cargarVista('modulo2.html')">📗 Módulo 2</a>
          </div>
          <a href="#" class="side-item" onclick="cargarVista('usuarios')">🧑🏻‍💻 Usuarios</a>
        </nav>
      </aside>

      <!-- OVERLAY -->
      <div class="sidebar-overlay" id="sidebarOverlay"></div>

      <!-- CONTENIDO -->
      <main class="contenido" id="contenido">
        <!-- Aquí se carga todo -->
      </main>
    </div>

    <!-- 🔥 SCRIPT -->
    <script>
      /* Sidebar */
      var layout = document.querySelector(".layout");
      var overlay = document.getElementById("sidebarOverlay");
      var btn = document.getElementById("btnMenu");

      btn.addEventListener("click", function () {
        layout.classList.toggle("sidebar-abierto");

        if (window.innerWidth <= 768) {
          overlay.classList.toggle("visible");
        }
      });

      overlay.addEventListener("click", function () {
        layout.classList.remove("sidebar-abierto");
        overlay.classList.remove("visible");
      });

      /* Cargar vistas */
      function cargarVista(ruta) {
        fetch(ruta)
          .then((res) => res.text())
          .then((html) => {
            document.getElementById("contenido").innerHTML = html;
          });
      }

      /* Eliminar usuario */
      async function eliminarUsuario(id) {
        const result = await Swal.fire({
          title: "¿Eliminar usuario?",
          text: "Esta acción no se puede deshacer",
          icon: "warning",
          showCancelButton: true,
          confirmButtonText: "Sí, eliminar",
        });

        if (!result.isConfirmed) return;

        const res = await fetch("/eliminar-usuario", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ id }),
        });

        const data = await res.json();

        if (data.ok) {
          Swal.fire("Eliminado", "Usuario eliminado", "success");

          setTimeout(() => {
            cargarVista("/usuarios");
          }, 800);
        } else {
          Swal.fire("Error", data.error, "error");
        }
      }

      /* Cargar dashboard por defecto */
      window.onload = function () {
        cargarVista("principal");
      };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
      function toggleSubmenu(elemento) {
        const submenu = elemento.nextElementSibling;

        if (submenu.style.display === "flex") {
          submenu.style.display = "none";
        } else {
          submenu.style.display = "flex";
        }
      }
    </script>
  </body>
</html>
